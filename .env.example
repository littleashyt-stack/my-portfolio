# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Long random string used to sign admin session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=b4ecdb5aeb881284d27dcaa1a0ab5ae939ccd2a94d963ae8ffb8cc282dceee97

# Used only by `npm run db:seed` to create your admin login.
# Change ADMIN_PASSWORD to something strong before running the seed command.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-password

# Not a secret — this is displayed publicly as your contact number.
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567
